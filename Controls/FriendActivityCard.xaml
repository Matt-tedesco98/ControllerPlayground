<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ControllerPlayground.Controls.FriendActivityCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ControllerPlayground.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Button
        Width="220"
        Height="64"
        HorizontalContentAlignment="Left"
        Padding="12">

        <StackPanel
            Orientation="Horizontal"
            Spacing="12">

            <Border
                Width="40"
                Height="40"
                Background="#505050"
                CornerRadius="4">

                <Image
                    x:Name="AvatarImage"
                    Stretch="UniformToFill" />

            </Border>

            <StackPanel VerticalAlignment="Center">

                <TextBlock
                    x:Name="FriendNameText"
                    FontSize="16" />

                <TextBlock
                    x:Name="PlayTimeText"
                    FontSize="13"
                    Opacity="0.6" />

            </StackPanel>

        </StackPanel>

    </Button>

</UserControl>
