<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ControllerPlayground.Controls.ActivityFeedCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ControllerPlayground.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Button
        HorizontalAlignment="Stretch"
        Padding="0">

        <Grid
            MinHeight="140"
            Background="#303030">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <Image
                x:Name="FeedImage"
                Grid.Column="0"
                Stretch="UniformToFill"/>

            <StackPanel
                Grid.Column="1"
                Margin="20"
                Spacing="8"
                VerticalAlignment="Center">
                
                <TextBlock
                    x:Name="SubtitleText"
                    FontSize="13"
                    Opacity="0.6"/>
                
                <TextBlock
                    x:Name="TitleText"
                    FontSize="20"
                    FontWeight="SemiBold"
                    TextWrapping="Wrap"/>
                
                <TextBlock
                    x:Name="DateText"
                    FontSize="13"
                    Opacity="0.6"/>

            </StackPanel>
            
        </Grid>
        
    </Button>
    
</UserControl>
