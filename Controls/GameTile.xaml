<UserControl
    x:Class="ControllerPlayground.Controls.GameTile"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Button
        x:Name="TileButton"
        Width="220"
        Height="320"
        Margin="6"
        Padding="0"
        CornerRadius="18"
        HorizontalContentAlignment="Stretch"
        VerticalContentAlignment="Stretch"
        GotFocus="TileButton_GotFocus"
        LostFocus="TileButton_LostFocus">

        <Grid>
            
            <!-- FallBack background-->
            <Border
                Background="#343434"
                CornerRadius="18" />
            
            <!-- Steam Cover Image -->
            <Border
                CornerRadius="13">
                
                <Image
                    x:Name="CoverImage"
                    Stretch="UniformToFill"
                    ImageFailed="CoverImage_ImageFailed" />
                
            </Border>
            
            <!-- Gradient Overlay -->
            <Border
                CornerRadius="18">

                <Border.Background>
                    <LinearGradientBrush
                        StartPoint="0.5,0"
                        EndPoint="0.5,1">

                        <GradientStop
                            Color="#00000000"
                            Offset="0.35" />

                        <GradientStop
                            Color="#E6000000"
                            Offset="1" />

                    </LinearGradientBrush>
                </Border.Background>

            </Border>

            <TextBlock
                x:Name="TitleText"
                Text="{x:Bind Title, Mode=OneWay}"
                VerticalAlignment="Bottom"
                Margin="16"
                FontSize="22"
                FontWeight="SemiBold"
                Foreground="White"
                TextWrapping="Wrap"
                MaxLines="2"/>
            
        </Grid>
        
    </Button>
    
</UserControl>