<UserControl
    x:Class="ControllerPlayground.Controls.GameTile"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Button
        x:Name="TileButton"
        Width="220"
        Height="320"
        Padding="0"
        CornerRadius="18"
        HorizontalContentAlignment="Stretch"
        VerticalContentAlignment="Stretch"
        GotFocus="TileButton_GotFocus"
        LostFocus="TileButton_LostFocus">

        <Grid>
            
            <!-- FallBack background-->
            <Border
                Background="#343434"
                CornerRadius="18" />

            <Border
                CornerRadius="13">
                
                <Image
                    x:Name="CoverImage"
                    Stretch="UniformToFill"
                    ImageFailed="CoverImage_ImageFailed" />
                
            </Border>

            <Border
                CornerRadius="18">

                <Border.Background>
                    <LinearGradientBrush
                        StartPoint="0.5,0"
                        EndPoint="0.5,1">
                        
                        <GradientStop
                            Color="#00000000"
                            Offset="0.35" />
                        
                        <GradientStop
                            Color="#E6000000"
                            Offset="1" />
                        
                    </LinearGradientBrush>
                </Border.Background>
                
            </Border>

            <StackPanel
                VerticalAlignment="Bottom"
                Padding="18"
                Spacing="6">

                <TextBlock
                    x:Name="TitleText"
                    Text="{x:Bind Title, Mode=OneWay}"
                    FontSize="24"
                    FontWeight="SemiBold"
                    Foreground="White"
                    TextWrapping="Wrap" />

                <TextBlock
                    Text="Press Enter to launch"
                    FontSize="14"
                    Foreground="#B8B8B8" />
            </StackPanel>
        </Grid>
    </Button>
</UserControl>