<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ControllerPlayground.Overlays.FriendsOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ControllerPlayground.Overlays"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:ControllerPlayground.Models"
    xmlns:Control="using:ControllerPlayground.Controls"
    mc:Ignorable="d">

    <Grid
        x:Name="OverlayRoot"
        Background="#111820"
        Width="420"
        HorizontalAlignment="Right">
        
        <StackPanel Margin="24" Spacing="16">

            <TextBlock
                Text="Friends"
                FontSize="28"
                FontWeight="SemiBold"/>

            <ItemsControl
                x:Name="FriendsList"
                ItemsSource="{x:Bind Friends, Mode=OneWay}">

                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:SteamFriend">

                        <Control:SteamFriendCard
                            Item="{x:Bind}"
                            Activated="FriendCard_Activated"/>

                    </DataTemplate>
                </ItemsControl.ItemTemplate>

            </ItemsControl>

        </StackPanel>
        
    </Grid>
    
</UserControl>
