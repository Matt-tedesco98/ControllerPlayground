<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ControllerPlayground.Overlays.FriendsOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ControllerPlayground.Overlays"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:ControllerPlayground.Models"
    xmlns:Control="using:ControllerPlayground.Controls"
    mc:Ignorable="d">

    <Grid
        x:Name="OverlayRoot"
        Background="#111820"
        Width="420"
        HorizontalAlignment="Right">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420"/>
            <ColumnDefinition Width="420"/>
        </Grid.ColumnDefinitions>
        
        
        <!-- Friends List -->
        <Grid
    Grid.Column="0"
    Margin="24">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock
        Grid.Row="0"
        Text="Friends"
        FontSize="28"
        FontWeight="SemiBold"
        Margin="0,0,0,16"/>

            <ScrollViewer
        Grid.Row="1"
        VerticalScrollMode="Enabled"
        VerticalScrollBarVisibility="Hidden">

                <ItemsControl
            x:Name="FriendsList"
            ItemsSource="{x:Bind Friends, Mode=OneWay}">

                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:SteamFriend">

                            <Control:SteamFriendCard
                        Item="{x:Bind}"
                        Activated="FriendCard_Activated"/>

                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </ScrollViewer>

            <Control:ControllerPromptBar
                x:Name="PromptBar"
                Grid.Row="2"
                Margin="0,16,0,0"
                ShowAccept="True"
                ShowBack="True"
                ShowView="True"
                ShowMenu="False"
                AcceptLabel="Select"
                BackLabel="Back"
                ViewLabel="Close" />

        </Grid>

        <!-- Chat Pane -->
            <local:FriendChatPane
                x:Name="ChatPane"
                Grid.Column="1"
                Visibility="Collapsed"/>
        
    </Grid>
    
</UserControl>
