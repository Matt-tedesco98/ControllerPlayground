<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ControllerPlayground.Overlays.GameContextMenu"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ControllerPlayground.Overlays"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border
        x:Name="MenuRoot"
        Width="320"
        Background="#252525"
        CornerRadius="12"
        Padding="16">
        
        <StackPanel Spacing="8">

            <TextBlock
                x:Name="TitleText"
                Text="{x:Bind GameTitle, Mode=OneWay}"
                FontSize="24"
                FontWeight="SemiBold"
                Margin="8,4,8,12"/>
            
            <Button
                x:Name="PlayButton"
                Content="Play"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                FontSize="20"
                GotFocus="ContextButton_GotFocus"
                LostFocus="ContextButton_LostFocus"/>

            <Button
                x:Name="DetailsButton"
                Content="Game Details"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                FontSize="20"
                GotFocus="ContextButton_GotFocus"
                LostFocus="ContextButton_LostFocus"/>
            
            <Button
                x:Name="ManageButton"
                Content="Manage"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                FontSize="20"
                GotFocus="ContextButton_GotFocus"
                LostFocus="ContextButton_LostFocus"/>
            
            <Button
                x:Name="PropertiesButton"
                Content="Properties"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                FontSize="20"
                GotFocus="ContextButton_GotFocus"
                LostFocus="ContextButton_LostFocus"/>

        </StackPanel>
    </Border>
</UserControl>
