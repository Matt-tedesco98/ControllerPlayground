<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ControllerPlayground.Overlays.FriendChatPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ControllerPlayground.Overlays"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:ControllerPlayground.Models"
    xmlns:Control="using:ControllerPlayground.Controls"
    mc:Ignorable="d">

    <Grid
        Width="420"
        Background="#18222C">
        
        <StackPanel
            Margin="24"
            Spacing="16">
            
            <StackPanel
                Orientation="Horizontal"
                Spacing="12">

                <Border
                    Width="48"
                    Height="48"
                    CornerRadius="6"
                    Background="#505050">
                    
                    <Image
                        x:Name="AvatarImage"
                        Stretch="UniformToFill"/>
                    
                </Border>
                
                <TextBlock
                    x:Name="FriendNameText"
                    FontSize="22"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center"/>

            </StackPanel>

            <ScrollViewer
                x:Name="MessagesScrollViewer"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">

                <ItemsControl
                ItemsSource="{x:Bind Messages, Mode=OneWay}">

                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="8"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:SteamChatMessage">

                            <Control:SteamChatMessageBubble
                            Item="{x:Bind}"/>

                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

                </ItemsControl>
                
            </ScrollViewer>

            <StackPanel
                Orientation="Horizontal"
                Spacing="8"
                Margin="0,12,0,0">

                <TextBox
                    x:Name="MessageInput"
                    Width="300"
                    PlaceholderText="Message..." />
                
                <Button
                    Content="Send"
                    Click="SendButton_Click"/>

            </StackPanel>

        </StackPanel>
        
    </Grid>
    
</UserControl>
