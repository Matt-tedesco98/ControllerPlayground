<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ControllerPlayground.Overlays.GuideMenu"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ControllerPlayground.Overlays"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid
        x:Name="GuideRoot"
        Background="#99000000">
        <Border
            Width="420"
            HorizontalAlignment="Left"
            VerticalAlignment="Stretch"
            Background="#202020"
            Padding="32">

            <StackPanel Spacing="24">
                <TextBlock
                    Text="Guide"
                    FontSize="32"
                    FontWeight="SemiBold"/>

                <StackPanel
                    x:Name="CurrentGamePanel"
                    Spacing="8"
                    Visibility="Collapsed">

                    <TextBlock
                        Text="Current Game"
                        FontSize="14"
                        Foreground="#A8A8A8"/>

                    <TextBlock
                        x:Name="CurrentGameTitleText"
                        FontSize="22"
                        FontWeight="SemiBold"
                        TextWrapping="Wrap"/>
                    
                    <TextBlock
                        x:Name="CurrentGameStatusText"
                        Text="Running"
                        FontSize="16"
                        Foreground="#A8A8A8"/>

                    <Button
                        x:Name="ResumeGameButton"
                        Content="Resume Game"
                        FontSize="22"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        GotFocus="GuideButton_GotFocus"
                        LostFocus="GuideButton_LostFocus"/>
                    
                    <Border
                        Height="1"
                        Background="#404040"
                        Margin="0,8,0,0"/>

                </StackPanel>

                <Button 
                    x:Name="LibraryButton"
                    Content="Library"
                    FontSize="22"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    GotFocus="GuideButton_GotFocus"
                    LostFocus="GuideButton_LostFocus"/>
                <Button 
                    x:Name="SettingsButton"
                    Content="Settings" 
                    FontSize="22"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    GotFocus="GuideButton_GotFocus"
                    LostFocus="GuideButton_LostFocus"/>
                <Button 
                    Content="Discord" 
                    FontSize="22"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left" 
                    GotFocus="GuideButton_GotFocus"
                    LostFocus="GuideButton_LostFocus"/>
                <Button 
                    Content="Power" 
                    FontSize="22"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left" 
                    GotFocus="GuideButton_GotFocus"
                    LostFocus="GuideButton_LostFocus"/>

            </StackPanel>
            
        </Border>
        
    </Grid>
    
</UserControl>
