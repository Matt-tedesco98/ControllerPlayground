<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ControllerPlayground.Overlays.OnScreenKeyboard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ControllerPlayground.Overlays"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid
        x:Name="KeyboardRoot"
        Background="#DD101010"
        Padding="40">

        <Border
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="#202020"
            CornerRadius="16"
            Padding="28">
            
            <StackPanel
                Width="900"
                Spacing="20">
                
                <TextBlock
                    Text="Keyboard" 
                    FontSize="28"
                    FontWeight="SemiBold"/>
                
                <Border
                    Background="#303030"
                    CornerRadius="8"
                    Padding="16">
                    
                    <TextBox
                        x:Name="PreviewText"
                        FontSize="24"
                        TextWrapping="Wrap"/>
                </Border>

                <StackPanel
                    x:Name="KeyboardRowsPanel"
                    Spacing="10"/>
                
            </StackPanel>
            
        </Border>

    </Grid>
</UserControl>
