<Window x:Class="ControllerPlayground.MainWindow" 
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
        xmlns:controls="using:ControllerPlayground.Controls"
        xmlns:views="using:ControllerPlayground.Views"
        xmlns:overlays="using:ControllerPlayground.Overlays"
		Title="Controller Playground">

    <Grid
		x:Name="PlayArea"
		Background="#202020"
		IsTabStop="True">
        
        <ContentControl 
            x:Name="ScreenHost" 
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"/>

        <Border
            x:Name="SteamUnreadBadge"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="0,24,24,0"
            MinWidth="36"
            Height="36"
            Padding="10,0"
            CornerRadius="18"
            Background="#505050"
            Visibility="Collapsed">
            
            <TextBlock
                x:Name="SteamUnreadCountText"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="16"
                FontWeight="SemiBold"/>
            
        </Border>
        
        <Grid
            x:Name="OverlayLayer"
            Canvas.ZIndex="20"
            Visibility="Collapsed">

            <overlays:GuideMenu
                x:Name="GuideMenu"/>
        </Grid>

        <Grid
            x:Name="FriendsOverlayLayer"
            Canvas.ZIndex="10"
            Background="Transparent"
            Visibility="Collapsed"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">

            <overlays:FriendsOverlay
                x:Name="FriendsOverlay" />

        </Grid>

        <Grid
            x:Name="SteamQrOverlayLayer"
            Canvas.ZIndex="30"
            Visibility="Collapsed"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
            
            <overlays:SteamQrLoginOverlay
                x:Name="SteamQrLoginOverlay" />

        </Grid>

        <StackPanel x:Name="ShellNavigationButtons" Canvas.ZIndex="5"
                    Orientation="Horizontal" Spacing="12" Margin="24"
                    HorizontalAlignment="Left" VerticalAlignment="Bottom">
            <Button x:Name="ShellGuideButton" Content="Guide" Click="ShellGuideButton_Click" />
            <Button x:Name="ShellFriendsButton" Content="Friends" Click="ShellFriendsButton_Click" />
        </StackPanel>
        <Border x:Name="OwnershipPanel" Canvas.ZIndex="40" Visibility="Collapsed"
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="16"
                Background="#E0202830" Padding="12" CornerRadius="8">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <TextBlock x:Name="OwnershipStatusText" MaxWidth="600" TextWrapping="Wrap"
                           Foreground="White" VerticalAlignment="Center" />
                <Button x:Name="CloseOwnershipButton" Content="Close" Click="CloseOwnershipButton_Click" />
            </StackPanel>
        </Border>
        <InfoBar x:Name="KeyboardFailureInfo" Canvas.ZIndex="50" IsOpen="False" IsClosable="True"
                 Severity="Error" Title="Text entry" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="24" />
    </Grid>

</Window>
