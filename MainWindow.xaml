<Window x:Class="ControllerPlayground.MainWindow" 
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
        xmlns:controls="using:ControllerPlayground.Controls"
        xmlns:views="using:ControllerPlayground.Views"
        xmlns:overlays="using:ControllerPlayground.Overlays"
		Title="Controller Playground">

    <Grid
		x:Name="PlayArea"
		Background="#202020"
		IsTabStop="True">
        
        <ContentControl 
            x:Name="ScreenHost" 
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"/>
        <Grid
            x:Name="OverlayLayer"
            Visibility="Collapsed">

            <overlays:GuideMenu
                x:Name="GuideMenu"/>
        </Grid>
        
    </Grid>

</Window>