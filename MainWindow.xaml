<Window x:Class="ControllerPlayground.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Controller Playground">

    <Grid
    x:Name="PlayArea"
    Background="#202020"
    KeyDown="PlayArea_KeyDown"
    IsTabStop="True">

        <Rectangle
        x:Name="Player"
        Width="60"
        Height="60"
        Fill="DodgerBlue"
        HorizontalAlignment="Left"
        VerticalAlignment="Top"
        Margin="100,100,0,0" />

        <TextBlock
        Text="Use the arrow keys to move"
        Foreground="White"
        FontSize="24"
        HorizontalAlignment="Center"
        VerticalAlignment="Top"
        Margin="0,30,0,0" />
    </Grid>

</Window>