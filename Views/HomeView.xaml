<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ControllerPlayground.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ControllerPlayground.Controls"
    xmlns:overlays="using:ControllerPlayground.Overlays">

    <Grid
        x:Name="HomeRoot"
        Background="#202020"
        IsTabStop="True">


        <ScrollViewer
            x:Name="LibraryScrollViewer"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            HorizontalScrollMode="Enabled"
            HorizontalScrollBarVisibility="Hidden"
            VerticalScrollMode="Disabled"
            VerticalScrollBarVisibility="Disabled">
            
            <StackPanel
                x:Name="GameTitlePanel"
                Orientation="Horizontal"
                Spacing="24"
                Padding="24"
                XYFocusKeyboardNavigation="Enabled"/>
            
        </ScrollViewer>
        
        <StackPanel
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Margin="24"
            Spacing="20">

            <controls:ControllerPromptBar
                x:Name="PromptBar" />

        </StackPanel>

        <Grid
            x:Name="ContextMenuLayer"
            Visibility="Collapsed">

            <overlays:GameContextMenu
                x:Name="GameMenu" 
                HorizontalAlignment="Center"
                VerticalAlignment="Center"/>
        </Grid>

    </Grid>

</UserControl>