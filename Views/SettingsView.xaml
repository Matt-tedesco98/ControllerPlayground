<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ControllerPlayground.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ControllerPlayground.Controls">

    <Grid Background="#202020">
        <TextBlock
            Text="Settings"
            FontSize="36"
            HorizontalAlignment="Center"
            VerticalAlignment="Center" />

        <controls:ControllerPromptBar
            x:Name="PromptBar"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Margin="24"
            ShowAccept="False"
            ShowBack="True"
            ShowView="False"
            ShowMenu="False"
            BackLabel="Back" />
        
    </Grid>

</UserControl>
