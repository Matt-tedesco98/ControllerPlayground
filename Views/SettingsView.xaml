<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ControllerPlayground.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ControllerPlayground.Controls">

    <Grid x:Name="SettingsRoot" Background="#202020">
        
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        
        <TextBlock
            Grid.Row="0"
            Text="Settings"
            FontSize="36"
            FontWeight="SemiBold"
            Margin="40,32,40,24" />
        
        <StackPanel
            Grid.Row="1"
            Margin="40,0,40,0"
            Spacing="12"
            Width="400"
            HorizontalAlignment="Left">

            <Button
                x:Name="AudioButton"
                Content="Audio"
                FontSize="22"
                HorizontalAlignment="Stretch" />

            <Button
                x:Name="DisplayButton"
                Content="Display"
                FontSize="22"
                HorizontalAlignment="Stretch" />

            <Button
                x:Name="ControllersButton"
                Content="Controllers"
                FontSize="22"
                HorizontalAlignment="Stretch" />

            <Button
                x:Name="PowerButton"
                Content="Power"
                FontSize="22"
                HorizontalAlignment="Stretch" />

        </StackPanel>

        <Border
            x:Name="AudioPanel"
            Grid.Row="1"
            Width="420"
            Padding="24"
            Margin="0,0,40,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Background="#2B2B2B"
            CornerRadius="12" >
            
            <StackPanel Spacing="16">
                
                <TextBlock
                    Text="Audio Output"
                    FontSize="26"
                    FontWeight="SemiBold" />

                <TextBlock
                    Text="Current Device"
                    FontSize="16"
                    Foreground="#AAAAAA"/>

                <TextBlock 
                    x:Name="AudioStatusText"
                    Text="Select Audio to inspect current output"
                    FontSize="20"
                    TextWrapping="Wrap" />

                <ProgressBar
                    x:Name="AudioVolumeBar"
                    Minimum="0"
                    Maximum="100"
                    Value="0"
                    Height="12"
                    IsIndeterminate="False"
                    IsTabStop="False"
                    Foreground="#4A90E2"
                    Background="#444444" />

                <Border
                    Height="1"
                    Background="#444444" />

                <TextBlock
                    Text="D-pad Left / Right - Adjust Volume"
                    FontSize="16" />
                
                <TextBlock
                    Text="X / Square - Mute or Unmute"
                    FontSize="16" />
                
            </StackPanel>
            
        </Border>

        <Border
            x:Name="PowerPanel"
            Grid.Row="1"
            Width="420"
            Padding="24"
            Margin="0,0,40,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Background="#2B2B2B"
            CornerRadius="12" 
            Visibility="Collapsed">

            <StackPanel Spacing="16">
                
                <TextBlock
                    Text="Power Options"
                    FontSize="26"
                    FontWeight="SemiBold" />

                <Button
                    x:Name="SleepButton"
                    Content="Sleep"
                    HorizontalAlignment="Stretch" />
                
                <Button
                    x:Name="RestartButton"
                    Content="Restart PC"
                    HorizontalAlignment="Stretch" />
                
                <Button
                    x:Name="ShutdownButton"
                    Content="Shutdown PC"
                    HorizontalAlignment="Stretch" />
                
                <Button
                    x:Name="ExitAppButton"
                    Content="Exit ControllerPlayground"
                    HorizontalAlignment="Stretch" />
                
            </StackPanel>
            
        </Border>

        <controls:ControllerPromptBar
            x:Name="PromptBar"
            Grid.Row="2"
            HorizontalAlignment="Right"
            Margin="24"
            ShowAccept="True"
            ShowBack="True"
            ShowView="False"
            ShowMenu="False"
            BackLabel="Back" />

        <Grid
            x:Name="ExitConfirmationLayer"
            Grid.RowSpan="3"
            Background="#CC000000"
            Visibility="Collapsed">

            <Border
                Width="460"
                Padding="32"
                Background="#2B2B2B"
                CornerRadius="12"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" >

                <StackPanel Spacing="16">
                    
                    <TextBlock
                        Text="Exit ControllerPlayground?"
                        FontSize="26"
                        FontWeight="SemiBold" />
                    
                    <TextBlock
                        Text="This will close ControllerPlayground, not Windows."
                        TextWrapping="Wrap"
                        FontSize="17" />
                    
                    <Button
                        x:Name="CancelExitButton"
                        Content="Cancel"
                        HorizontalAlignment="Stretch" />
                    
                    <Button
                        x:Name="ConfirmExitButton"
                        Content="Exit ControllerPlayground"
                        HorizontalAlignment="Stretch" />
                    
                </StackPanel>
                
            </Border>
            
        </Grid>
        
    </Grid>

</UserControl>
