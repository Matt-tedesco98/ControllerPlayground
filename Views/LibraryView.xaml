<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ControllerPlayground.Views.LibraryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ControllerPlayground.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:ControllerPlayground.Controls"
    xmlns:models="using:ControllerPlayground.Models"
    xmlns:overlays="using:ControllerPlayground.Overlays"
    mc:Ignorable="d">

    <Grid
        x:Name="LibraryRoot"
        Background="#202020">
        
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel
            Margin="48,36,48,20"
            Spacing="6">
            
            <TextBlock
                Text="Library"
                FontSize="36"
                FontWeight="SemiBold"
                Foreground="White" />

            <TextBlock
                x:Name="GameCountText"
                Text="Loading games..."
                FontSize="18"
                Foreground="#B8B8B8"/>
            
        </StackPanel>
        
        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollMode="Disabled"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollMode="Enabled"
            VerticalScrollBarVisibility="Hidden">
            
            <ItemsRepeater
                x:Name="LibraryRepeater"
                ItemsSource="{x:Bind Games, Mode=OneWay}"
                XYFocusKeyboardNavigation="Enabled">

                <ItemsRepeater.Layout>
                    <UniformGridLayout
                        MinItemWidth="245"
                        MinItemHeight="345"
                        MinRowSpacing="20"
                        ItemsJustification="SpaceAround"/>
                </ItemsRepeater.Layout>

                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="models:SteamLibraryGame">

                        <controls:GameTile
                            Title="{x:Bind Name}"
                            CoverImageUrl="{x:Bind LibraryCapsuleUrl}"
                            Activated="GameTile_Activated"/>

                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>

            </ItemsRepeater>
            
        </ScrollViewer>

        <Grid 
            x:Name="ContextMenuLayer"
            Visibility="Collapsed">

            <overlays:GameContextMenu
                x:Name="GameMenu"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"/>
        </Grid>

    </Grid>
    
</UserControl>
