<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ControllerPlayground.Views.GamePageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ControllerPlayground.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:Control="using:ControllerPlayground.Controls">

    <Grid Background="#202020">
        <Grid.RowDefinitions>
            <RowDefinition Height="320"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <!-- Hero area -->
        <Grid Grid.Row="0">

            <Image
                x:Name="HeroImage"
                Stretch="UniformToFill"/>

            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00000000" Offset="0.35"/>
                        <GradientStop Color="#CC202020" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <TextBlock
                Text="{x:Bind Game.Title, Mode=OneWay}"
                FontSize="36"
                Margin="48"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"/>
        </Grid>

        <!-- Main action / metadata row -->
        <StackPanel
            Grid.Row="1"
            Orientation="Horizontal"
            Spacing="24"
            Margin="48,24">

            <Button
                Content="Play"
                Width="220"
                Height="56"
                FontSize="22"/>

            <TextBlock
                Text="{x:Bind Game.LastPlayed, Mode=OneWay}"
                VerticalAlignment="Center"/>

            <TextBlock
                Text="{x:Bind Game.PlayTime, Mode=OneWay}"
                VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Content area -->
        <Grid Grid.Row="2">

            <ScrollViewer
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled">

                <StackPanel
            Spacing="20"
            Margin="48">

                    <!-- Tab strip -->
                    <Grid HorizontalAlignment="Center">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Control:ControllerGlyph
                    x:Name="LeftShoulderGlyph"
                    Grid.Column="0"
                    Button="LeftShoulder"
                    VerticalAlignment="Center"
                    Margin="0,0,20,0"/>

                        <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="28">

                            <Button
                        x:Name="ActivityTabButton"
                        Content="Activity"/>

                            <Button
                        x:Name="YourStuffTabButton"
                        Content="Your Stuff"/>

                            <Button
                        x:Name="CommunityTabButton"
                        Content="Community"/>

                            <Button
                        x:Name="GameInfoTabButton"
                        Content="Game Info"/>

                        </StackPanel>

                        <Control:ControllerGlyph
                    x:Name="RightShoulderGlyph"
                    Grid.Column="2"
                    Button="RightShoulder"
                    VerticalAlignment="Center"
                    Margin="20,0,0,0"/>

                    </Grid>

                    <!-- Game Info -->
                    <Grid x:Name="GameInfoContent">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border
                    Grid.Column="0"
                    Width="220"
                    Height="320"
                    CornerRadius="8"
                    Background="#303030"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top">

                            <Image
                        x:Name="CoverImage"
                        Stretch="UniformToFill"/>

                        </Border>

                        <StackPanel
                    Grid.Column="1"
                    Margin="32,0,0,0"
                    Spacing="16">

                            <TextBlock
                        Text="{x:Bind Game.Description, Mode=OneWay}"
                        FontSize="18"
                        TextWrapping="Wrap"
                        MaxWidth="900"
                        HorizontalAlignment="Left"/>

                            <StackPanel
                        Spacing="8"
                        Margin="0,12,0,0">

                                <TextBlock
                            Text="{x:Bind Game.Developer, Mode=OneWay}"
                            FontSize="16"/>

                                <TextBlock
                            Text="{x:Bind Game.Publisher, Mode=OneWay}"
                            FontSize="16"/>

                                <TextBlock
                            Text="{x:Bind Game.ReleaseDate, Mode=OneWay}"
                            FontSize="16"/>

                            </StackPanel>

                        </StackPanel>

                    </Grid>

                </StackPanel>

            </ScrollViewer>

        </Grid>

        <Control:ControllerPromptBar
            x:Name="PromptBar"
            Grid.Row="3"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Margin="24"/>

    </Grid>
</UserControl>
