<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ControllerPlayground.Input\ControllerPlayground.Input.csproj" />
  </ItemGroup>
  <Target Name="CopyNativeForTests" AfterTargets="Build" Condition="Exists('..\x64\$(Configuration)\ControllerInput.dll')">
    <Copy SourceFiles="..\x64\$(Configuration)\ControllerInput.dll" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
