<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ControllerPlayground.KeyboardHost.Controls.OnScreenKeyboard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid
        x:Name="KeyboardRoot"
        Background="Transparent">

        <Border
            Background="#F0202020"
            CornerRadius="14"
            Padding="12">

            <StackPanel Spacing="8">

                <Border
                    Background="#303030"
                    CornerRadius="8"
                    Padding="10,6">

                    <TextBlock
                        x:Name="PreviewText"
                        FontSize="18"
                        TextWrapping="Wrap"
                        MaxHeight="52"/>

                </Border>

                <StackPanel
                    x:Name="KeyboardRowsPanel"
                    Spacing="6"/>

            </StackPanel>

        </Border>

    </Grid>

</UserControl>